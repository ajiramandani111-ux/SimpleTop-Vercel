# PostgreSQL connection for Vercel.
# Recommended: use the pooled/serverless connection string from your provider (e.g. Neon).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional alternative if DATABASE_URL is not used:
# PGHOST=your-host
# PGPORT=5432
# PGDATABASE=simpletop
# PGUSER=your-user
# PGPASSWORD=your-password
# PGSSLMODE=require
